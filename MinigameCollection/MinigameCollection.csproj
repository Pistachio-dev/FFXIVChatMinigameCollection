<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/13.0.0">
    <PropertyGroup>
        <Authors>Pistachio Herald</Authors>
        <Version>0.0.0.1</Version>
        <RootNamespace>MinigameCollection</RootNamespace>
        <AssemblyName>MinigameCollection</AssemblyName>
        <FileVersion>0.0.0.1</FileVersion>
        <AssemblyVersion>0.0.0.1</AssemblyVersion>
        <Description>A collection of chat minigames for FFXIV</Description>
        <PackageProjectUrl>https://https://github.com/Pistachio-dev/MinigameCollection</PackageProjectUrl>
        <PackageId>MinigameCollection</PackageId>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Platforms>x64</Platforms>
        <Nullable>enable</Nullable>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DalamudBasics\DalamudBasics\DalamudBasics.csproj" />
        <ProjectReference Include="..\PersistentModel\PersistentModel.csproj" />
    </ItemGroup>
</Project>
